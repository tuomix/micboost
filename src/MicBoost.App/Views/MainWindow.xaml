<Window x:Class="MicBoost.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:MicBoost.App.Controls"
        xmlns:vm="clr-namespace:MicBoost.App.ViewModels"
        Title="MicBoost" Width="940" Height="760" MinWidth="780" MinHeight="560"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="StatusPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Background" Value="{StaticResource Surface3Brush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusKind}" Value="ok">
                    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="warn">
                    <Setter Property="Background" Value="{StaticResource WarnSoftBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="error">
                    <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="muted">
                    <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Fill" Value="{StaticResource TextDimBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusKind}" Value="ok">
                    <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="warn">
                    <Setter Property="Fill" Value="{StaticResource WarnBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="error">
                    <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="muted">
                    <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HideWhenEmpty" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
                <Trigger Property="Text" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ClipLed" TargetType="Border">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="{StaticResource Surface3Brush}" />
            <Setter Property="ToolTip" Value="Clipping indicator (lights for 1.5 s)" />
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="22,18,22,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Header -->
            <Grid Grid.ColumnSpan="3" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/micboost.ico" Width="28" Height="28" Margin="0,0,10,0"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="MicBoost" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Border Style="{StaticResource StatusPill}" Margin="14,2,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Style="{StaticResource StatusDot}" Margin="0,0,7,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Latency" Foreground="{StaticResource TextDimBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding LatencyText}" Style="{StaticResource Value}" FontSize="14"
                               ToolTip="Estimated added delay: mic buffer + processing + cable buffers. Measured live from the device buffers." />
                </StackPanel>
            </Grid>

            <!-- Banners -->
            <StackPanel Grid.Row="1" Grid.ColumnSpan="3">
                <Border Background="{StaticResource WarnSoftBrush}" BorderBrush="{StaticResource WarnBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="18,14" Margin="0,0,0,14"
                        Visibility="{Binding ShowCableBanner, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="{Binding CableBannerTitle}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource WarnBrush}" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding CableBannerText}" Style="{StaticResource Hint}" Foreground="{StaticResource TextBrush}" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                       Text="Until then MicBoost still runs and shows levels, but other apps cannot hear the boosted mic." />
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Button Content="Download VB-CABLE" Style="{StaticResource AccentButton}" Command="{Binding DownloadCableCommand}"
                                    ToolTip="Opens https://vb-audio.com/Cable/ in your browser" Margin="0,0,0,8" />
                            <Button Content="Check again" Command="{Binding RecheckCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Background="{StaticResource DangerSoftBrush}" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="18,12" Margin="0,0,0,14">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EngineMessage}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding EngineMessage}" TextWrapping="Wrap" />
                </Border>
                <TextBlock Text="{Binding SettingsLoadError}" Style="{StaticResource HideWhenEmpty}" Foreground="{StaticResource WarnBrush}" Margin="0,0,0,12" />
            </StackPanel>

            <!-- LEFT COLUMN -->
            <StackPanel Grid.Row="2" Grid.Column="0">

                <!-- Devices -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Devices" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="MICROPHONE (INPUT)" Style="{StaticResource Caption}" />
                        <ComboBox ItemsSource="{Binding CaptureDevices}" SelectedItem="{Binding SelectedCapture}" Tag="{Binding CapturePlaceholder}"
                                  AutomationProperties.Name="Microphone" />
                        <TextBlock Text="SEND BOOSTED MIC TO" Style="{StaticResource Caption}" Margin="0,14,0,8" />
                        <ComboBox ItemsSource="{Binding OutputDevices}" SelectedItem="{Binding SelectedOutput}" Tag="{Binding OutputPlaceholder}"
                                  AutomationProperties.Name="Output device" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                   Visibility="{Binding OutputIsCable, Converter={StaticResource BoolToVis}}">
                            In Discord, games and Windows, choose <Run Text="CABLE Output (VB-Audio Virtual Cable)" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" /> as the microphone.
                        </TextBlock>
                        <TextBlock Text="{Binding OutputMessage}" Style="{StaticResource HideWhenEmpty}" Foreground="{StaticResource WarnBrush}" Margin="0,8,0,0" />

                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,16,0,14" />
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding MonitorEnabled}">
                            <StackPanel>
                                <TextBlock Text="Monitor (hear yourself)" />
                                <TextBlock Text="Off by default. Can cause echo or feedback through speakers; use headphones." Style="{StaticResource Hint}" />
                            </StackPanel>
                        </CheckBox>
                        <ComboBox ItemsSource="{Binding MonitorDevices}" SelectedItem="{Binding SelectedMonitor}" Tag="Select headphones"
                                  Margin="0,10,0,0" AutomationProperties.Name="Monitor device"
                                  Visibility="{Binding MonitorEnabled, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Border>

                <!-- Boost -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Boost" Style="{StaticResource CardTitle}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <TextBox x:Name="GainBox" Text="{Binding GainText, UpdateSourceTrigger=LostFocus}" Width="104"
                                         FontFamily="{StaticResource MonoFont}" FontSize="20" TextAlignment="Right" Padding="6,2"
                                         AutomationProperties.Name="Gain in decibels" KeyDown="GainBox_KeyDown" />
                                <TextBlock Text="dB" FontSize="16" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                            </StackPanel>
                        </Grid>
                        <Slider Minimum="0" Maximum="30" Value="{Binding GainDb}" SmallChange="0.5" LargeChange="3"
                                Margin="0,10,0,0" AutomationProperties.Name="Gain" />
                        <Grid Margin="2,2,2,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="0" Style="{StaticResource Hint}" HorizontalAlignment="Left" />
                            <TextBlock Grid.Column="1" Text="+10" Style="{StaticResource Hint}" HorizontalAlignment="Left" Margin="-9,0,0,0" />
                            <TextBlock Grid.Column="2" Text="+20" Style="{StaticResource Hint}" HorizontalAlignment="Left" Margin="-9,0,0,0" />
                            <TextBlock Grid.Column="2" Text="+30 dB" Style="{StaticResource Hint}" HorizontalAlignment="Right" />
                        </Grid>
                        <UniformGrid Columns="2" Margin="0,16,0,0">
                            <ToggleButton Style="{StaticResource StateToggle}" IsChecked="{Binding Muted}" Tag="{StaticResource DangerBrush}" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="Mute" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding HotkeyMute}" FontSize="11" FontWeight="Normal" Opacity="0.7" HorizontalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton Style="{StaticResource StateToggle}" IsChecked="{Binding Bypass}" Tag="{StaticResource TextDimBrush}" Margin="6,0,0,0"
                                          ToolTip="Bypass sends your raw mic signal through without boost or processing.">
                                <StackPanel>
                                    <TextBlock Text="Bypass" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding HotkeyBypass}" FontSize="11" FontWeight="Normal" Opacity="0.7" HorizontalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- Processing -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Processing" Style="{StaticResource CardTitle}" />
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding GateEnabled}">
                            <StackPanel>
                                <TextBlock Text="Noise gate" />
                                <TextBlock Text="Turns the mic down when you are not talking. Threshold is shown in amber on the input meter." Style="{StaticResource Hint}" />
                            </StackPanel>
                        </CheckBox>
                        <Grid Margin="0,8,0,0" IsEnabled="{Binding GateEnabled}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="58" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Threshold" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <Slider Grid.Column="1" Minimum="-80" Maximum="-20" Value="{Binding GateThresholdDb}" SmallChange="1" LargeChange="5"
                                    AutomationProperties.Name="Gate threshold" />
                            <TextBlock Grid.Column="2" Text="{Binding GateThresholdText}" Style="{StaticResource Value}" HorizontalAlignment="Right" />
                        </Grid>

                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,14,0,12" />
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Compressor" />
                                <TextBlock Text="Evens out loud and quiet speech." Style="{StaticResource Hint}" />
                            </StackPanel>
                            <Border HorizontalAlignment="Right" Background="{StaticResource Surface2Brush}" CornerRadius="9"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Segment}" Content="Off" IsChecked="{Binding CompOff}" GroupName="Comp" />
                                    <RadioButton Style="{StaticResource Segment}" Content="Light" IsChecked="{Binding CompLight}" GroupName="Comp" />
                                    <RadioButton Style="{StaticResource Segment}" Content="Voice" IsChecked="{Binding CompVoice}" GroupName="Comp" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,12,0,12" />
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Limiter" />
                                <TextBlock Text="{Binding LimiterText}" Style="{StaticResource Hint}" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                                <TextBlock Text="reducing" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock x:Name="GainReductionText" Text="0.0 dB" Style="{StaticResource Value}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- RIGHT COLUMN -->
            <StackPanel Grid.Row="2" Grid.Column="2">

                <!-- Levels -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Levels" Style="{StaticResource CardTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="54" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Input" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                            <c:LevelMeterBar x:Name="InputMeter" Grid.Column="1" Height="14" VerticalAlignment="Center" MarkerDb="{Binding GateMarkerDb}" />
                            <TextBlock x:Name="InputText" Grid.Column="2" Text="-∞" Style="{StaticResource Value}" HorizontalAlignment="Right" />
                            <Border x:Name="InputClip" Grid.Column="3" Style="{StaticResource ClipLed}" Margin="10,0,0,0" />

                            <TextBlock Grid.Row="2" Text="Output" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                            <c:LevelMeterBar x:Name="OutputMeter" Grid.Row="2" Grid.Column="1" Height="14" VerticalAlignment="Center" />
                            <TextBlock x:Name="OutputText" Grid.Row="2" Grid.Column="2" Text="-∞" Style="{StaticResource Value}" HorizontalAlignment="Right" />
                            <Border x:Name="OutputClip" Grid.Row="2" Grid.Column="3" Style="{StaticResource ClipLed}" Margin="10,0,0,0" />
                        </Grid>
                        <Grid Margin="54,4,86,0">
                            <TextBlock Text="-60" Style="{StaticResource Hint}" FontSize="10" HorizontalAlignment="Left" />
                            <TextBlock Text="-30" Style="{StaticResource Hint}" FontSize="10" HorizontalAlignment="Center" />
                            <TextBlock Text="0 dBFS" Style="{StaticResource Hint}" FontSize="10" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0" FontSize="11"
                                   Text="Bar = RMS (loudness), white line = peak, numbers = RMS. A red dot on Input means the mic itself is clipping: lower the boost or move the mic away." />
                        <TextBlock Text="{Binding FormatText}" Style="{StaticResource HideWhenEmpty}" FontSize="11" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <!-- Presets -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Presets" Style="{StaticResource CardTitle}" />
                        <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" Tag="Custom (unsaved)"
                                  AutomationProperties.Name="Preset" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Save as…" Command="{Binding SavePresetCommand}" Margin="0,0,8,0" />
                            <Button Content="Delete" Command="{Binding DeletePresetCommand}" ToolTip="Delete the selected custom preset" />
                        </StackPanel>
                        <TextBlock Text="{Binding PresetError}" Style="{StaticResource HideWhenEmpty}" Foreground="{StaticResource WarnBrush}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- Settings -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Settings" Style="{StaticResource CardTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Mute hotkey" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBox x:Name="MuteHotkeyBox" Grid.Column="1" Text="{Binding HotkeyMute, Mode=OneWay}" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                     PreviewKeyDown="HotkeyBox_PreviewKeyDown" Tag="mute" Cursor="Hand"
                                     ToolTip="Click, then press a key combination. Backspace clears." AutomationProperties.Name="Mute hotkey" />
                            <TextBlock Grid.Row="2" Text="Bypass hotkey" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBox x:Name="BypassHotkeyBox" Grid.Row="2" Grid.Column="1" Text="{Binding HotkeyBypass, Mode=OneWay}" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                     PreviewKeyDown="HotkeyBox_PreviewKeyDown" Tag="bypass" Cursor="Hand"
                                     ToolTip="Click, then press a key combination. Backspace clears." AutomationProperties.Name="Bypass hotkey" />
                        </Grid>
                        <TextBlock Text="{Binding HotkeyError}" Style="{StaticResource HideWhenEmpty}" Foreground="{StaticResource WarnBrush}" Margin="0,6,0,0" />

                        <CheckBox Style="{StaticResource Switch}" Content="Start with Windows" IsChecked="{Binding StartWithWindows}" Margin="0,14,0,0" />
                        <TextBlock Text="{Binding StartupError}" Style="{StaticResource HideWhenEmpty}" Foreground="{StaticResource WarnBrush}" Margin="0,4,0,0" />
                        <CheckBox Style="{StaticResource Switch}" Content="Start minimized to the tray" IsChecked="{Binding StartMinimized}" Margin="0,10,0,0" />
                        <CheckBox Style="{StaticResource Switch}" Content="Closing the window keeps MicBoost running" IsChecked="{Binding CloseToTray}" Margin="0,10,0,0" />
                        <Grid Margin="0,12,0,0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Buffering" />
                                <TextBlock Text="Use Safe if you hear crackles." Style="{StaticResource Hint}" />
                            </StackPanel>
                            <ComboBox HorizontalAlignment="Right" Width="120" ItemsSource="{Binding LatencyModes}" SelectedItem="{Binding Latency}"
                                      AutomationProperties.Name="Buffering" />
                        </Grid>

                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,14,0,12" />
                        <WrapPanel>
                            <Button Content="Check for updates" Command="{Binding CheckUpdatesCommand}" Margin="0,0,8,8"
                                    ToolTip="Opens the GitHub releases page in your browser. MicBoost never connects to the internet by itself." />
                            <Button Content="Open settings folder" Command="{Binding OpenSettingsFolderCommand}" Margin="0,0,8,8" />
                        </WrapPanel>
                        <Expander Header="Diagnostics" Foreground="{StaticResource TextDimBrush}" Margin="0,4,0,0">
                            <TextBlock Text="{Binding HardwareText}" Style="{StaticResource Hint}" Margin="0,6,0,0" FontSize="11" />
                        </Expander>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Footer -->
            <TextBlock Grid.Row="4" Grid.ColumnSpan="3" Style="{StaticResource Hint}" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,10">
                <Run Text="{Binding VersionText, Mode=OneWay}" /> · No telemetry, no network, nothing is ever recorded.
            </TextBlock>
        </Grid>
    </ScrollViewer>
</Window>
